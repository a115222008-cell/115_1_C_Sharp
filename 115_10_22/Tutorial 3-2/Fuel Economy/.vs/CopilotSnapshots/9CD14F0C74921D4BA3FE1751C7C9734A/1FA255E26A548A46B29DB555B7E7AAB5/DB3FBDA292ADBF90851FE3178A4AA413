using System;
using System.Collections.Generic;
using System.ComponentModel;
using System.Data;
using System.Drawing;
using System.Linq;
using System.Text;
using System.Threading.Tasks;
using System.Windows.Forms;

namespace Fuel_Economy
{
    // 燃油經濟性計算表單。
    public partial class Form1 : Form
    {
        // 建立表單並初始化表單上的控制項。
        public Form1()
        {
            InitializeComponent();
        }

        // 按下計算按鈕時，計算每公升可行駛的公里數。
        private void calculateButton_Click(object sender, EventArgs e)
        {
            // 宣告行駛里程、耗油量及燃油經濟性的變數。
            double km;
            double liters;
            double kmpl;

            // 取得使用者輸入的行駛里程與耗油量，並轉換為 double 型別。
            km = double.Parse(kmTextBox.Text);
            liters = double.Parse(litersTextBox.Text);

            // 以行駛里程除以耗油量，計算每公升可行駛的公里數。
            kmpl = km / liters;
            
            kmplLabel.Text = kmpl.ToString() + " 公里/公升";
        }

        // 按下離開按鈕時關閉目前的表單。
        private void exitButton_Click(object sender, EventArgs e)
        {
            // 關閉表單。
            this.Close();
        }
    }
}
